root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2
# Markdown 里行尾两个空格是换行，不要自动裁掉。
trim_trailing_whitespace = false

[*.{json,properties}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
