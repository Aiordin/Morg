    <!-- 欢迎页（首次进入） -->
    <string name="welcome_title">欢迎使用 Morg</string>
    <string name="welcome_body">Morg 为正在使用的应用再开一个实例。两种入口：边缘手柄，或控制中心的「新开窗口」。</string>
    <string name="welcome_point_service_title">边缘手柄</string>
    <string name="welcome_point_service_body">打开后，在任意应用里从屏幕边缘拉出抽屉即可多开。第一次打开会引导授予两项必需权限。</string>
    <string name="welcome_point_window_title">打开方式</string>
    <string name="welcome_point_window_body">默认全屏；打开小窗开关后，新实例以悬浮小窗出现，可以和原来的画面同时看。</string>
    <string name="welcome_point_toolbar_title">控制中心</string>
    <string name="welcome_point_toolbar_body">在控制中心放一个「新开窗口」按钮（下滑两次 → 编辑 → 拖入面板）。它与边缘手柄互相独立，手柄关着也能用。</string>
    <string name="welcome_start">开始使用</string>

    <!-- 打开方式引导（开关首次打开） -->
    <string name="window_guide_title">打开方式：小窗</string>
    <string name="window_guide_body">新实例默认全屏。打开这个开关后，新实例会以悬浮小窗打开，原应用仍留在后面。小窗需要系统支持，先确认一次再开启。</string>
