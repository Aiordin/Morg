<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        小窗自检结束时把主界面所在的 task 切回前台。REORDER_TASKS 是普通权限，
        不需要用户授权；换成 startActivity(CLEAR_TOP) 会把 MainActivity 塞进
        刚开出来的小窗 task 里，主界面直接变小窗（实测）。
    -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!--
        Android 11+ 的包可见性：不声明这条，`getLaunchIntentForPackage` 对绝大多数
        第三方应用返回 null（侧滑会静默失败），`queryIntentActivities` 也只看得到几个应用。
        这条 intent 过滤只授予「查询桌面入口」的可见性，不是 QUERY_ALL_PACKAGES。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MorgApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Morg">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".launch.WindowProbeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/probe_title" />

        <service
            android:name=".overlay.HandleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Edge handle overlay kept alive while an app is in the foreground" />
        </service>

        <service
            android:name=".qs.MorgTileService"
            android:exported="true"
            android:icon="@drawable/ic_handle"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
